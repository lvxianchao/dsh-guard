{
  "name": "@lvxianchao/dsh-web-guard",
  "version": "1.0.0",
  "description": "Password-gated reverse proxy for DeepSeek Harness Web UI: one login, automatic launch-token exchange, Host/Origin rewrite, and a secure-context polyfill. Turns the token-only harness into a deployable service.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "locale",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "docs/logo.svg"
  ],
  "license": "MIT",
  "author": "lvxianchao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvxianchao/dsh-web-guard.git"
  },
  "homepage": "https://github.com/lvxianchao/dsh-web-guard#readme",
  "bugs": {
    "url": "https://github.com/lvxianchao/dsh-web-guard/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "auth",
    "reverse-proxy",
    "tls",
    "password",
    "login",
    "self-hosted",
    "cordis"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/e2e.mjs"
  }
}
